{
  "name": "xiangqi",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "path-to-regexp@<0.1.13": "0.1.13"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "lan": "pnpm build && node scripts/start-lan.mjs",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "test": "pnpm --filter client test && pnpm --filter server test",
    "contract:check": "node scripts/check-online-contract.mjs",
    "release:check": "pnpm format:check && pnpm contract:check && pnpm test && pnpm build && git diff --check",
    "security:audit": "pnpm audit --prod --audit-level high",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6"
  }
}

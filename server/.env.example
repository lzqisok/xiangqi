# The existing local/LAN server leaves MySQL disabled by default.
ONLINE_DATABASE_ENABLED=false
NODE_ENV=development
XIANGQI_DATA_DIR=/var/lib/xiangqi/games
XIANGQI_ROOM_DIR=/var/lib/xiangqi/rooms

# Required when ONLINE_DATABASE_ENABLED=true and by db:* commands.
DATABASE_URL=mysql://xiangqi_app:change-me@127.0.0.1:3306/xiangqi_development
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=8000

# Tests require a loopback MySQL database whose name contains "test". The test
# user must be allowed to create and drop isolated xiangqi_test_* databases.
TEST_DATABASE_URL=mysql://xiangqi_test:change-me@127.0.0.1:3306/xiangqi_test

# Public account runtime. Keep token exposure off outside local development;
# production must replace the built-in no-op delivery adapter before launch.
AUTH_DEV_EXPOSE_TOKENS=false
AUTH_ALLOWED_ORIGINS=https://chess.example.com
AUTH_DELIVERY_WEBHOOK_URL=https://mailer.example.internal/account-token
AUTH_DELIVERY_WEBHOOK_TOKEN=replace-with-secret-store-value

# Public rollout modes: off disables the account match runtime; controlled allows
# only the listed immutable user IDs; drain rejects new matches/joins while
# existing matches, history and reconnects remain available; open is general access.
# PUBLIC_ONLINE_ENABLED remains a legacy off/open fallback when MODE is omitted.
# The frontend build must set VITE_PUBLIC_ONLINE_ENABLED for any non-off mode.
PUBLIC_ONLINE_ENABLED=false
PUBLIC_ONLINE_MODE=off
PUBLIC_ONLINE_ALLOWED_USER_IDS=
PUBLIC_REGISTRATION_ENABLED=true
PUBLIC_ORIGIN=https://chess.example.com
TRUSTED_PROXY_CIDRS=10.0.0.0/8
METRICS_TOKEN=replace-with-secret-store-value

# Request, WebSocket, room, and engine resource ceilings.
API_JSON_LIMIT=64kb
IMPORT_JSON_LIMIT=2mb
PAYLOAD_MAX_DEPTH=12
PAYLOAD_MAX_FIELDS=2000
WS_MAX_PAYLOAD_BYTES=131072
GOMOKU_WS_MAX_PAYLOAD_BYTES=32768
MAX_WS_PER_IP=30
MAX_WS_PER_USER=10
MAX_PLAYER_CONNECTIONS_PER_USER=2
MAX_SPECTATORS_PER_MATCH=50
MAX_ACTIVE_MATCHES_PER_USER=3
MAX_MATCHMAKING_QUEUE_ENTRIES=100
MAX_ENGINE_PROCESSES=6
MAX_ENGINE_TASKS=4
SHUTDOWN_GRACE_MS=10000
HTTP_SUCCESS_LOG_SAMPLE_RATE=0.1

# Immutable release manifest. Production startup rejects missing placeholders.
DEPLOYMENT_VERSION=development
PIKAFISH_VERSION=development
JIEQI_ENGINE_VERSION=development
RAPFI_VERSION=development
ENGINE_WEIGHTS_VERSION=development

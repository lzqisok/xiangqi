# The existing local/LAN server leaves MySQL disabled by default.
ONLINE_DATABASE_ENABLED=false
NODE_ENV=development

# Required when ONLINE_DATABASE_ENABLED=true and by db:* commands.
DATABASE_URL=mysql://xiangqi_app:change-me@127.0.0.1:3306/xiangqi_development
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=8000

# Tests require a loopback MySQL database whose name contains "test". The test
# user must be allowed to create and drop isolated xiangqi_test_* databases.
TEST_DATABASE_URL=mysql://xiangqi_test:change-me@127.0.0.1:3306/xiangqi_test

# Public account runtime. Keep token exposure off outside local development;
# production must replace the built-in no-op delivery adapter before launch.
AUTH_DEV_EXPOSE_TOKENS=false
AUTH_ALLOWED_ORIGINS=https://chess.example.com

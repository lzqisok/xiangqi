{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:migrate": "tsx src/db/migrate-cli.ts migrate",
    "db:status": "tsx src/db/migrate-cli.ts status",
    "db:check": "tsx src/db/migrate-cli.ts check",
    "db:backup": "bash scripts/backup-mysql.sh",
    "db:restore:verify": "bash scripts/verify-mysql-restore.sh",
    "platform:preflight": "node dist/platform/preflight.js",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "staging:read-load": "node scripts/staging-read-load.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "staging:business-load": "node scripts/staging-business-load.mjs",
    "staging:faults": "node scripts/staging-faults.mjs",
    "test:acceptance-tools": "node --test scripts/acceptance-tools.test.mjs",
    "online:interrupt": "tsx src/online/interrupt-cli.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^4.21.2",
    "mysql2": "^3.24.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  }
}

{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:migrate": "tsx src/db/migrate-cli.ts migrate",
    "db:status": "tsx src/db/migrate-cli.ts status",
    "db:check": "tsx src/db/migrate-cli.ts check",
    "db:backup": "bash scripts/backup-mysql.sh",
    "db:restore:verify": "bash scripts/verify-mysql-restore.sh",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^4.21.2",
    "mysql2": "^3.24.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  }
}
